# Clau API de Socrata (opcional però recomanada: evita límits de peticions).
# Es crea gratis iniciant sessió a analisi.transparenciacatalunya.cat > Developer Settings.
# ID de la clau:
SODA_APP_TOKEN=
# Clau secreta (necessària juntament amb l'ID per a l'autenticació Basic):
SODA_APP_SECRET=

# Base de dades Turso (Fase 3). URL: `turso db show viatges-cat --url`
TURSO_URL=
# Token de lectura i escriptura: `turso db tokens create viatges-cat`
TURSO_TOKEN=
